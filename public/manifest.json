{
  "name": "NIKKE Workshop",
  "short_name": "【王国大学习】NIKKE 战术整备室",
  "description": "【王国大学习】NIKKE战术整备室 1.0.4，集成角色数据获取与洗词条计算器。",
  "version": "1.0.4",
  "version_name": "NIKKE Workshop 1.0.4",
  "manifest_version": 3,

  "action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },

  "side_panel": {
    "default_path": "index.html"
  },

  "options_ui": {
    "page": "management.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },

  "permissions": [
    "cookies",
    "tabs",
    "storage",
    "scripting",
    "downloads",
    "sidePanel",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.blablalink.com/*",
    "https://nikke-db.github.io/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "images/icon-16.png",
        "images/icon-32.png",
        "images/icon-48.png",
        "images/icon-128.png",
        "cubes.json"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
