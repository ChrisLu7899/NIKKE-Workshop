{
  "name": "NIKKE Workshop",
  "short_name": "【王国大学习】NIKKE 战术整备室",
  "description": "【王国大学习】NIKKE战术整备室 1.0.13，集成角色数据获取与洗词条计算器。",
  "version": "1.0.13",
  "version_name": "NIKKE Workshop 1.0.13",
  "manifest_version": 3,

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },

  "action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },

  "side_panel": {
    "default_path": "index.html"
  },

  "options_ui": {
    "page": "management.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },

  "permissions": [
    "alarms",
    "cookies",
    "tabs",
    "storage",
    "scripting",
    "downloads",
    "sidePanel",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "*://*.blablalink.com/*",
    "https://nikke-db.github.io/*"
  ],
  "optional_host_permissions": [
    "https://pinkuro.top/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
